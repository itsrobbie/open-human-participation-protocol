{
  "name": "bank-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate-api": "openapi-typescript ../swagger.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate-api && npm run typecheck && esbuild src/app.ts --bundle --outfile=../src/Bank.Presentation/wwwroot/app.js --format=esm --target=es2020"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "openapi-fetch": "^0.10.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "openapi-fetch": "^0.10.0"
  }
}
