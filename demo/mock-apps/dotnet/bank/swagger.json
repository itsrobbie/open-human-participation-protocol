{
  "openapi": "3.0.1",
  "info": {
    "title": "Demo Bank API",
    "description": "OHPP-enabled mock bank application for demonstrating the Open Human Participation Protocol.",
    "version": "v1"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Bank.Presentation, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/.well-known/ohpp/auth-config": {
      "get": {
        "tags": [
          "Bank.Presentation, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BankAuthConfigResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts": {
      "get": {
        "tags": [
          "Bank.Presentation, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{id}": {
      "get": {
        "tags": [
          "Bank.Presentation, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/transfers": {
      "post": {
        "tags": [
          "Bank.Presentation, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/transfers/{requestId}/status": {
      "get": {
        "tags": [
          "Bank.Presentation, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "tags": [
          "Bank.Presentation, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransactionRecord"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/payees": {
      "post": {
        "tags": [
          "Bank.Presentation, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddPayeeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/ohpp/disconnect": {
      "delete": {
        "tags": [
          "Bank.Presentation, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/ohpp/scenarios/{scenario}": {
      "post": {
        "tags": [
          "Bank.Presentation, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "parameters": [
          {
            "name": "scenario",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/BankProtocolScenario"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BankScenarioRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BankProtocolScenarioResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BankProtocolScenarioResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/ohpp/scenarios/{requestId}/status": {
      "get": {
        "tags": [
          "Bank.Presentation, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BankProtocolScenarioStatus"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/ohpp/generate-challenge": {
      "post": {
        "tags": [
          "Bank.Presentation, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateBankChallengeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BankChallengeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/ohpp/callback": {
      "post": {
        "tags": [
          "Bank.Presentation, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/.well-known/ohpp/app-metadata": {
      "get": {
        "tags": [
          "Bank.Presentation, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Account": {
        "required": [
          "balance",
          "id",
          "name",
          "ownerUserId",
          "payees"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ownerUserId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "balance": {
            "type": "number",
            "format": "double"
          },
          "payees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Payee"
            }
          },
          "ohppRegistration": {
            "$ref": "#/components/schemas/OhppRegistration"
          }
        },
        "additionalProperties": false
      },
      "AddPayeeRequest": {
        "required": [
          "accountId",
          "accountNumber",
          "name",
          "sortCode"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "accountNumber": {
            "type": "string"
          },
          "sortCode": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "BankAuthConfigResponse": {
        "required": [
          "authority",
          "clientId"
        ],
        "type": "object",
        "properties": {
          "authority": {
            "type": "string"
          },
          "clientId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "BankChallengeResponse": {
        "required": [
          "challengeId",
          "challengeUri",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "challengeUri": {
            "type": "string"
          },
          "challengeId": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "BankProtocolScenario": {
        "enum": [
          "TransferDecision",
          "TransferControls",
          "PaymentReference",
          "TransferAmount",
          "PaymentDate",
          "PaymentDateTime",
          "HighValueAcknowledgement"
        ],
        "type": "string"
      },
      "BankProtocolScenarioResult": {
        "required": [
          "success"
        ],
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "requestId": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BankProtocolScenarioStatus": {
        "required": [
          "attestationVerified"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/RequestStatus"
          },
          "selectedOption": {
            "type": "string",
            "nullable": true
          },
          "selectedOptions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "value": {
            "type": "string",
            "nullable": true
          },
          "attestationVerified": {
            "type": "boolean"
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BankScenarioRequest": {
        "required": [
          "accountId"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "GenerateBankChallengeRequest": {
        "required": [
          "accountId"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "OhppRegistration": {
        "required": [
          "accessToken",
          "resolverUrl",
          "userId"
        ],
        "type": "object",
        "properties": {
          "resolverUrl": {
            "type": "string"
          },
          "accessToken": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Payee": {
        "required": [
          "accountNumber",
          "id",
          "name",
          "sortCode"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "accountNumber": {
            "type": "string"
          },
          "sortCode": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RequestStatus": {
        "enum": [
          "Pending",
          "Resolved",
          "Expired",
          "Cancelled"
        ],
        "type": "string"
      },
      "TransactionRecord": {
        "required": [
          "accountId",
          "amount",
          "createdAt",
          "id",
          "payeeName",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "payeeName": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "reference": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/TransferStatus"
          },
          "participationRequestId": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "scheduledFor": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TransferRequest": {
        "required": [
          "amount",
          "fromAccountId",
          "toPayeeId"
        ],
        "type": "object",
        "properties": {
          "fromAccountId": {
            "type": "string"
          },
          "toPayeeId": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "reference": {
            "type": "string",
            "nullable": true
          },
          "scheduledFor": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TransferResult": {
        "required": [
          "status",
          "success"
        ],
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "participationRequestId": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/TransferStatus"
          }
        },
        "additionalProperties": false
      },
      "TransferStatus": {
        "enum": [
          "Completed",
          "PendingApproval",
          "Denied",
          "Failed",
          "Expired",
          "Scheduled"
        ],
        "type": "string"
      }
    }
  }
}