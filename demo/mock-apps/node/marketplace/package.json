{
  "name": "@ohpp-demo/marketplace",
  "version": "1.0.0",
  "description": "NeonMarket - OHPP demo marketplace app (Node SDK)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ohpp/sdk": "file:../../../../sdks/node",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.52.1",
    "@opentelemetry/api-logs": "0.54.2",
    "@opentelemetry/exporter-logs-otlp-grpc": "0.54.2",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.54.2",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.54.2",
    "@opentelemetry/sdk-logs": "0.54.2",
    "@opentelemetry/resources": "1.27.0",
    "@opentelemetry/sdk-metrics": "1.27.0",
    "@opentelemetry/sdk-node": "0.54.2",
    "@opentelemetry/semantic-conventions": "1.27.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "pg": "^8.12.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.8",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "@opentelemetry/resources": "1.27.0",
    "@opentelemetry/sdk-metrics": "1.27.0"
  }
}
