          }
        }
      }
    },
    "/.well-known/ohpp/metadata": {
      "get": {
        "tags": [
          "OHPP.Presentation.Api, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/.well-known/ohpp/keys": {
