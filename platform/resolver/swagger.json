{
  "openapi": "3.0.1",
  "info": {
    "title": "OHPP Resolver API",
    "description": "Open Human Participation Protocol — Resolver API for portal management, device operations, and app registration.",
    "version": "v1"
  },
  "paths": {
    "/api/devices/me/keys": {
      "post": {
        "tags": [
          "Device"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterKeyRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterKeyRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterKeyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
