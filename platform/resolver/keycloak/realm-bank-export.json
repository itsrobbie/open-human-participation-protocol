{
  "realm": "ohpp-bank",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "none",
  "roles": { "realm": [{ "name": "bank-user" }] },
  "clients": [{
    "clientId": "ohpp-bank-app",
    "name": "OHPP Demo Bank",
    "enabled": true,
    "publicClient": true,
    "directAccessGrantsEnabled": true,
    "standardFlowEnabled": true,
    "redirectUris": ["http://localhost:5010/*", "http://localhost:20105/*", "http://localhost:20106/*", "http://localhost:20107/*", "http://localhost:20108/*", "http://localhost:20109/*", "http://localhost:20110/*", "http://localhost:20111/*", "http://localhost:20112/*", "http://localhost:20113/*", "http://localhost:20114/*", "http://localhost:20115/*", "http://localhost:20116/*", "http://localhost:20117/*", "http://localhost:20118/*", "http://localhost:20119/*"],
    "webOrigins": ["http://localhost:5010", "http://localhost:20105", "http://localhost:20106", "http://localhost:20107", "http://localhost:20108", "http://localhost:20109", "http://localhost:20110", "http://localhost:20111", "http://localhost:20112", "http://localhost:20113", "http://localhost:20114", "http://localhost:20115", "http://localhost:20116", "http://localhost:20117", "http://localhost:20118", "http://localhost:20119"],
    "protocol": "openid-connect",
    "protocolMappers": [
      {
        "name": "stable-ohpp-user-id",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-usermodel-attribute-mapper",
        "consentRequired": false,
        "config": {
          "user.attribute": "ohpp_user_id",
          "claim.name": "ohpp_user_id",
          "jsonType.label": "String",
          "access.token.claim": "true",
          "id.token.claim": "true",
          "userinfo.token.claim": "true"
        }
      },
      {
        "name": "bank-api-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": {
          "included.client.audience": "ohpp-bank-app",
          "access.token.claim": "true"
        }
      }
    ]
  }],
  "users": [{
    "id": "demo-bank-user",
    "username": "demo",
    "email": "demo@ohpp.dev",
    "firstName": "Demo",
    "lastName": "User",
    "enabled": true,
    "emailVerified": true,
    "attributes": { "ohpp_user_id": ["demo-user"] },
    "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
    "realmRoles": ["bank-user"]
  }]
}
