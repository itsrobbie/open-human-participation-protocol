{
  "realm": "ohpp",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Default user role"
      }
    ]
  },
  "defaultRoles": ["user"],
  "clients": [
    {
      "clientId": "ohpp-portal",
      "name": "OHPP Portal",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:5050/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:5050"],
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*"
      }
    }
  ],
  "users": [
    {
      "id": "demo-user",
      "username": "demo",
      "email": "demo@ohpp.dev",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "ohpp_user_id": ["demo-user"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    }
  ]
}
