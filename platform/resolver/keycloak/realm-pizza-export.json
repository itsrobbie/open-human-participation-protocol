{
  "realm": "ohpp-pizza",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "none",
  "roles": { "realm": [{ "name": "pizza-user" }] },
  "clients": [{
    "clientId": "ohpp-pizza-app",
    "name": "Slice & Dice Pizza",
    "enabled": true,
    "publicClient": true,
    "directAccessGrantsEnabled": true,
    "standardFlowEnabled": true,
    "redirectUris": ["http://localhost:5030/*", "http://localhost:20135/*", "http://localhost:20136/*", "http://localhost:20137/*", "http://localhost:20138/*", "http://localhost:20139/*", "http://localhost:20140/*", "http://localhost:20141/*", "http://localhost:20142/*", "http://localhost:20143/*", "http://localhost:20144/*", "http://localhost:20145/*", "http://localhost:20146/*", "http://localhost:20147/*", "http://localhost:20148/*", "http://localhost:20149/*"],
    "webOrigins": ["http://localhost:5030", "http://localhost:20135", "http://localhost:20136", "http://localhost:20137", "http://localhost:20138", "http://localhost:20139", "http://localhost:20140", "http://localhost:20141", "http://localhost:20142", "http://localhost:20143", "http://localhost:20144", "http://localhost:20145", "http://localhost:20146", "http://localhost:20147", "http://localhost:20148", "http://localhost:20149"],
    "protocol": "openid-connect",
    "protocolMappers": [
      {
        "name": "stable-ohpp-user-id",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-usermodel-attribute-mapper",
        "consentRequired": false,
        "config": {
          "user.attribute": "ohpp_user_id",
          "claim.name": "ohpp_user_id",
          "jsonType.label": "String",
          "access.token.claim": "true",
          "id.token.claim": "true",
          "userinfo.token.claim": "true"
        }
      },
      {
        "name": "pizza-api-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": {
          "included.client.audience": "ohpp-pizza-app",
          "access.token.claim": "true"
        }
      }
    ]
  }],
  "users": [{
    "id": "demo-pizza-user",
    "username": "demo",
    "email": "demo@ohpp.dev",
    "firstName": "Demo",
    "lastName": "User",
    "enabled": true,
    "emailVerified": true,
    "attributes": { "ohpp_user_id": ["demo-user"] },
    "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
    "realmRoles": ["pizza-user"]
  }]
}
