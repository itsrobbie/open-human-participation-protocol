{
  "realm": "ohpp-pizza",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "none",
  "roles": { "realm": [{ "name": "pizza-user" }] },
  "clients": [{
    "clientId": "ohpp-pizza-app",
    "name": "Slice & Dice Pizza",
    "enabled": true,
    "publicClient": true,
    "directAccessGrantsEnabled": true,
    "standardFlowEnabled": true,
    "redirectUris": ["http://localhost:5030/*", "http://localhost:5130/*"],
    "webOrigins": ["http://localhost:5030", "http://localhost:5130"],
    "protocol": "openid-connect",
    "protocolMappers": [
      {
        "name": "stable-ohpp-user-id",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-usermodel-attribute-mapper",
        "consentRequired": false,
        "config": {
          "user.attribute": "ohpp_user_id",
          "claim.name": "ohpp_user_id",
          "jsonType.label": "String",
          "access.token.claim": "true",
          "id.token.claim": "true",
          "userinfo.token.claim": "true"
        }
      },
      {
        "name": "pizza-api-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": {
          "included.client.audience": "ohpp-pizza-app",
          "access.token.claim": "true"
        }
      }
    ]
  }],
  "users": [{
    "id": "demo-pizza-user",
    "username": "demo",
    "email": "demo@ohpp.dev",
    "firstName": "Demo",
    "lastName": "User",
    "enabled": true,
    "emailVerified": true,
    "attributes": { "ohpp_user_id": ["demo-user"] },
    "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
    "realmRoles": ["pizza-user"]
  }]
}
