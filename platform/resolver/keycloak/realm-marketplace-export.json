{
  "realm": "ohpp-marketplace",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "none",
  "roles": { "realm": [{ "name": "marketplace-user" }] },
  "clients": [{
    "clientId": "ohpp-marketplace-app",
    "name": "NeonMarket",
    "enabled": true,
    "publicClient": true,
    "directAccessGrantsEnabled": true,
    "standardFlowEnabled": true,
    "redirectUris": ["http://localhost:5040/*", "http://localhost:20150/*", "http://localhost:20151/*", "http://localhost:20152/*", "http://localhost:20153/*", "http://localhost:20154/*", "http://localhost:20155/*", "http://localhost:20156/*", "http://localhost:20157/*", "http://localhost:20158/*", "http://localhost:20159/*", "http://localhost:20160/*", "http://localhost:20161/*", "http://localhost:20162/*", "http://localhost:20163/*", "http://localhost:20164/*"],
    "webOrigins": ["http://localhost:5040", "http://localhost:20150", "http://localhost:20151", "http://localhost:20152", "http://localhost:20153", "http://localhost:20154", "http://localhost:20155", "http://localhost:20156", "http://localhost:20157", "http://localhost:20158", "http://localhost:20159", "http://localhost:20160", "http://localhost:20161", "http://localhost:20162", "http://localhost:20163", "http://localhost:20164"],
    "protocol": "openid-connect",
    "protocolMappers": [
      {
        "name": "stable-ohpp-user-id",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-usermodel-attribute-mapper",
        "consentRequired": false,
        "config": {
          "user.attribute": "ohpp_user_id",
          "claim.name": "ohpp_user_id",
          "jsonType.label": "String",
          "access.token.claim": "true",
          "id.token.claim": "true",
          "userinfo.token.claim": "true"
        }
      },
      {
        "name": "marketplace-api-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": {
          "included.client.audience": "ohpp-marketplace-app",
          "access.token.claim": "true"
        }
      }
    ]
  }],
  "users": [{
    "id": "demo-marketplace-user",
    "username": "demo",
    "email": "demo@ohpp.dev",
    "firstName": "Demo",
    "lastName": "User",
    "enabled": true,
    "emailVerified": true,
    "attributes": { "ohpp_user_id": ["demo-user"] },
    "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
    "realmRoles": ["marketplace-user"]
  }]
}
