    <ProjectReference Include="..\OHPP.Services.Shared\OHPP.Services.Shared.csproj" />
    <ProjectReference Include="..\OHPP.Services.Auth\OHPP.Services.Auth.csproj" />
    <ProjectReference Include="..\OHPP.Services.Registration\OHPP.Services.Registration.csproj" />
    <ProjectReference Include="..\OHPP.Services.Participation\OHPP.Services.Participation.csproj" />
    <ProjectReference Include="..\OHPP.Services.Attestation\OHPP.Services.Attestation.csproj" />
    <ProjectReference Include="..\OHPP.Infrastructure.Firebase\OHPP.Infrastructure.Firebase.csproj" />
    <ProjectReference Include="..\OHPP.Infrastructure.Keycloak\OHPP.Infrastructure.Keycloak.csproj" />
    <ProjectReference Include="..\OHPP.Infrastructure.PostgreSQL\OHPP.Infrastructure.PostgreSQL.csproj" />
