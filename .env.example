# PostgreSQL
POSTGRES_PASSWORD=ohpp_dev_password

# Resolver
RESOLVER_ENCRYPTION_KEY=dev-encryption-key-min-32-chars!!

# GlitchTip (crash reporting) - dev-only defaults; set real values for prod
GLITCHTIP_DB_PASSWORD=ohpp_glitchtip_dev_password
GLITCHTIP_SECRET_KEY=ohpp-glitchtip-dev-secret-key-change-me
# Fixed public key (UUID) so the seeded dev DSN is deterministic. The Flutter
# app's crash DSN in dev is: http://<32-char-hex-of-this>@localhost:8000/<project_id>
OHPP_GLITCHTIP_PUBLIC_KEY=0bbc1e00-c11e-4000-8000-000000000001

# Local dev CA (step-ca) - dev-only password for the CA key material (U7.1 HTTPS everywhere)
STEPCA_PASSWORD=ohpp-dev-ca-password

# Umami (product analytics, opt-in `analytics` profile) - dev-only defaults.
# Umami replaced PostHog (Postgres-only, no Kafka/ClickHouse). Reuses World
# Postgres via its own `umami` db. The website UUID is the analytics tracking key
# and is pinned so it is deterministic across clean runs.
UMAMI_DB_PASSWORD=ohpp_umami_dev_password
UMAMI_APP_SECRET=ohpp-umami-dev-secret-change-me
UMAMI_ADMIN_PASSWORD=umami
OHPP_UMAMI_WEBSITE_ID=0a119000-0b11-4000-8000-000000000002

# Placeholder stubs (opt-in `analytics` profile; not consumed by app logic yet)
MINIO_ROOT_USER=ohpp_minio_dev
MINIO_ROOT_PASSWORD=ohpp_minio_dev_password
OPENBAO_DEV_ROOT_TOKEN=ohpp-openbao-dev-root

# ----- Developer-local (.env.local, git-ignored) -----
# Machine-specific values do NOT belong in this committed file or in .env.
# Put them in .env.local (git-ignored), which the Makefile auto-includes. Example:
#   FLUTTER_E2E_DEVICE=iPhone 17 Pro w/ Watch
# This pins which booted iOS simulator `make flutter-test-e2e` runs on. Using a
# simulator avoids the iOS "Untrusted Developer" prompt that a physical device
# shows after each debug reinstall. Find names: xcrun simctl list devices available

# Firebase (optional — for production identity token validation)
# FIREBASE_PROJECT_ID=your-firebase-project-id
